# Vercel → Project → Settings → Environment Variables में ये डालें (असली कीमतें यहाँ न रखें)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=            # service-account JSON की private_key (\n वैसे ही रहने दें)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=                # plan_xxx  (₹29 / हर 1 महीना)
RAZORPAY_PLAN_ID_YEARLY=         # plan_xxx  (₹299 / हर 1 साल)
RAZORPAY_WEBHOOK_SECRET=
LEMON_CHECKOUT_URL=              # https://STORE.lemonsqueezy.com/checkout/buy/VARIANT-UUID  ($5 / month)
LEMON_CHECKOUT_URL_YEARLY=       # वैसा ही URL, $25 / year वाले variant का
LEMON_WEBHOOK_SECRET=
LEMON_API_KEY=                   # रद्द करने के लिए
ADMIN_EMAILS=                    # आपका Gmail (कॉमा से कई); सिर्फ़ ये /admin.html चला सकते हैं
